{
  "pipeline_version": "significant_moves_2h_v1",
  "source_glob": "data/oanda_training_manager/candles/*_M1.csv",
  "bam_overlay_dir": "data/oanda_training_manager/candles_bam",
  "legacy_catalog": "data/oanda_training_manager/continuous_research/historical_major_moves.parquet",
  "output_root": "data/significant_moves",
  "primary_horizon_minutes": 120,
  "horizons_minutes": [90, 120, 150],
  "bar_minutes": 5,
  "scan_stride_minutes": 5,
  "broad_quantile": 0.99,
  "strict_quantile": 0.995,
  "minimum_threshold_history_windows": 1000,
  "fixed_minimum_pips": 0.0,
  "strict_minimum_atr_units": 1.5,
  "strict_minimum_move_to_cost": 3.0,
  "strict_minimum_path_efficiency": 0.1,
  "minimum_window_bar_coverage": 0.5,
  "quality_warning_bar_coverage": 0.9,
  "atr_lookback_minutes": 240,
  "atr_minimum_observations": 24,
  "slippage_pips_per_side": 0.2,
  "reversal_noise_pips": 0.1,
  "overlap_group_minimum_fraction": 0.3,
  "overlap_start_tolerance_minutes": 45,
  "parent_trend_gap_minutes": 15,
  "final_maximum_overlap_fraction": 0.0,
  "legacy_match_tolerance_minutes": 45,
  "workers": 2,
  "sqlite_include_raw_candidates": false,
  "sessions_utc": {
    "asia": [22, 7],
    "london": [7, 16],
    "new_york": [12, 21],
    "london_new_york_overlap": [12, 16]
  }
}
