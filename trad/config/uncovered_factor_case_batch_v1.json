  "execution_eligible": false,
  "logic_upgrades": [
    {
      "upgrade_id": "separate_hindsight_interval_from_event_entry",
      "definition": "A profitable census interval may begin before its proposed source. Report pre-source minutes explicitly and never relabel the hindsight start as a tradable entry."
    },
    {
      "upgrade_id": "source_clock_quality_gate",
      "definition": "Only original/provider exact clocks or exact reputable publication witnesses can establish historical knowledge time; date-only and later summaries remain context."
    },
    {
      "upgrade_id": "multi_phase_event_clock",
      "definition": "Represent decision, statement, projections, press conference, and later transcript as different phases with different causal availability."
    },
    {
      "upgrade_id": "progressive_event_sequence",
      "definition": "Elections and evolving policy negotiations are event sequences, not a single headline timestamp; preserve the ordered state transitions."
    },
    {
      "upgrade_id": "release_cascade_story_dedup",
      "definition": "National and regional releases in one scheduled cascade must be retained as ordered facts but counted as one market episode rather than independent confirmations."
    },
    {
      "upgrade_id": "factor_breadth_episode_dedup",
      "definition": "Correlated pair expressions establish cross-currency breadth and timing but count as one signed-currency episode."
    },
    {
      "upgrade_id": "semantic_direction_requires_response_confirmation",
      "definition": "Official text supplies facts and a watch state; directional use remains blocked without causal consensus/rate repricing or a frozen post-source factor-response rule."
    },
    {
      "upgrade_id": "cross_currency_risk_transmission",
      "definition": "Map geopolitical and trade shocks first to a risk/haven factor state, then test currency response breadth instead of hard-coding one pair direction."
    }
  ],
