      "models": ["toto_2"]
    },
    "foundation_ttm": {
      "python": "%FOREX_MODEL_RUNTIME_ROOT%\\foundation_ttm\\Scripts\\python.exe",
      "bootstrap_requirements": ["torch==2.10.0", "granite-tsfm==0.3.6"],
      "models": ["tiny_time_mixer"]
    }
  },
  "official_source_pins": {
