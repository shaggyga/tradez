        "catboost==1.2.10",
        "ngboost==0.5.11",
        "chronos-forecasting==2.3.1",
        "timesfm==2.0.2",
        "stable-baselines3==2.9.0",
        "vowpalwabbit==9.11.2",
        "pytest==9.1.1"
      ],
      "models": [
        "catboost",
        "ngboost",
        "tft",
        "deepar",
        "patchtst",
        "nbeats",
        "nhits",
        "lstm",
        "gru",
        "tcn",
        "temporal_cross_pair_gnn",
        "chronos_2",
        "timesfm_2_5",
        "contextual_bandit",
        "ppo",
        "sac",
        "dqn",
        "self_supervised_pretraining",
        "contrastive_learning",
        "multi_task_learning",
