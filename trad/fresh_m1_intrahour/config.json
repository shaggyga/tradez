    "return_lags_per_timeframe": 60,
    "materialization_stride_minutes": 5,
    "purge_minutes": 60,
    "validation_fraction": 0.20,
    "final_fraction": 0.20,
    "max_matrix_rows": 225000,
    "max_train_rows": 100000,
    "random_state": 42,
    "model_candidates": [
      "ridge_m1",
      "ridge_mtf_no_activity",
      "ridge_mtf_full",
      "extra_trees_mtf_full",
