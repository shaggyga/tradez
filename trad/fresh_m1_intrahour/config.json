    {"name": "tp3_sl5", "tp_pips": 3.0, "sl_pips": 5.0},
    {"name": "tp5_sl8", "tp_pips": 5.0, "sl_pips": 8.0},
    {"name": "tp8_sl12", "tp_pips": 8.0, "sl_pips": 12.0}
  ],
