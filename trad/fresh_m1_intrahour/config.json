  "tier1_pairs": [
    "EUR_USD", "GBP_USD", "USD_JPY", "USD_CHF", "USD_CAD",
    "AUD_USD", "NZD_USD", "EUR_JPY", "GBP_JPY", "AUD_JPY",
    "EUR_GBP", "EUR_AUD", "EUR_CAD", "GBP_AUD", "GBP_CAD"
