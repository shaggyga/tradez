{
  "schema_version": 1,
  "engine_name": "fresh_m1_intrahour_opportunity",
  "candles_dir": "data/oanda_training_manager/candles",
  "reports_dir": "fresh_m1_intrahour/reports",
  "account_currency": "USD",
