    {"name": "spread_3p5_6p0", "basis": "spread_pips_used", "tp_mult": 3.5, "sl_mult": 6.0, "min_tp_pips": 1.0, "min_sl_pips": 2.0},
    {"name": "range_0p30_0p50", "basis": "range_15m_pips", "tp_mult": 0.30, "sl_mult": 0.50, "min_tp_pips": 1.0, "min_sl_pips": 1.8}
