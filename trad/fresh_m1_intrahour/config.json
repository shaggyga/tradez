    "tradability_diagnostic": "next_bar_entry_executable_bid_ask_after_spread_and_slippage",
    "tick_volume_semantics": "oanda_price_update_count",
    "tick_volume_normalization": "pair_session_timeframe_historical_only",
    "order_book_training_eligible": false,
    "execution_depth_training_eligible": false,
    "account_eligible": false,
    "deployment_mode": "shadow_only",
    "live_execution_enabled": false,
    "oanda_execution_enabled": false
