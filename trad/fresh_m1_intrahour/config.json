    {"name": "atr_0p35_0p55", "basis": "atr_15m_pips", "tp_mult": 0.35, "sl_mult": 0.55, "min_tp_pips": 1.0, "min_sl_pips": 1.8},
    {"name": "atr_0p50_0p80", "basis": "atr_15m_pips", "tp_mult": 0.50, "sl_mult": 0.80, "min_tp_pips": 1.5, "min_sl_pips": 2.5},
